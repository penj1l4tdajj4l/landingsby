.barbar-toto-section{
    position:relative;
    background:linear-gradient(
    135deg,
    #180003 0%,
    #50000c 30%,
    #7a0014 55%,
    #c0c0c0 75%,
    #50000c 100%);
    color:#fff;
    border:2px solid #d7d7d7;
    border-radius:18px;
    padding:30px 25px;
    max-width:900px;
    margin:50px auto 70px;
    overflow:hidden;
    z-index:1;

    box-shadow:
    0 0 15px rgba(255,255,255,.25),
    0 0 30px rgba(192,192,192,.4),
    0 0 45px rgba(122,0,20,.8),
    inset 0 0 20px rgba(255,255,255,.12);
}


/* EFEK KILAU PREMIUM */
.barbar-toto-section:before{
    content:"";
    position:absolute;
    top:-100%;
    left:-120%;
    width:70%;
    height:300%;
    background:linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,.55),
    transparent);
    transform:rotate(25deg);
    animation:premiumShine 6s linear infinite;
}


@keyframes premiumShine{
    0%{
        left:-150%;
    }
    100%{
        left:180%;
    }
}


.banner{
    position:relative;
    width:100%;
    overflow:hidden;
}

.banner img{
    width:100%;
    height:auto;
    display:block;
    position:relative;
}


/* JUDUL */
.barbar-toto-section h2{
    font-size:26px;
    font-weight:800;
    margin-bottom:15px;
    color:#ffffff;
    text-align:center;
    text-shadow:
    0 0 8px #fff,
    0 0 15px #c0c0c0,
    0 0 25px #7a0014;
}


.barbar-toto-section h3{
    font-size:20px;
    color:#ffffff;
    margin-top:25px;
    margin-bottom:10px;
    text-shadow:
    0 0 5px #fff,
    0 0 15px #7a0014;
}


/* PARAGRAF */
.barbar-toto-section p{
    font-size:16px;
    line-height:1.8;
    margin-bottom:15px;
    color:#f3f3f3;
}


/* LINK */
.barbar-toto-section a{
    color:#ffffff;
    text-decoration:none;
    transition:.4s;
}


.barbar-toto-section a:hover{
    color:#d7d7d7;
    text-shadow:
    0 0 10px #fff,
    0 0 20px #c0c0c0;
}


/* RESPONSIVE */
@media(max-width:768px){

.barbar-toto-section{
    padding:20px 15px;
    margin:40px auto 100px;
}

.barbar-toto-section h2{
    font-size:22px;
}

.barbar-toto-section p{
    font-size:14.5px;
}

}


.page{
    height:5%;
    position:relative;
}

.content-main{
    min-height:500px;
    height:110%;
    padding:16px 0 32px;
    position:relative;
}

.header-mini{
    background:#000;
    height:200px;
    position:relative;
    text-align:center;
}


/* GLOW BERKEDIP HALUS */
@keyframes glowPremium{
    0%{
        box-shadow:
        0 0 15px rgba(255,255,255,.25),
        0 0 30px rgba(122,0,20,.7);
    }

    50%{
        box-shadow:
        0 0 25px rgba(255,255,255,.5),
        0 0 45px rgba(192,192,192,.8),
        0 0 60px rgba(122,0,20,1);
    }

    100%{
        box-shadow:
        0 0 15px rgba(255,255,255,.25),
        0 0 30px rgba(122,0,20,.7);
    }
}

.barbar-toto-section{
    animation:glowPremium 3s infinite ease-in-out;
}

