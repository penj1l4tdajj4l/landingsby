left:-10px;
top:-20px;

font-size:70px;

color:

rgba(255,255,255,.08);

font-family:serif;

}



/*====================================
            RESPONSIVE
====================================*/


@media(max-width:768px){

.testimonials{

padding:30px 15px;

}


