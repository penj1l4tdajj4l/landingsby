/*====================================
       PREMIUM MAROON CASINO
====================================*/


@keyframes premiumGlow{

0%,100%{

box-shadow:
0 0 20px rgba(255,255,255,.15),
0 0 40px rgba(122,0,20,.7);

}

50%{

box-shadow:
0 0 35px rgba(255,255,255,.4),
0 0 55px rgba(192,192,192,.5),
0 0 80px rgba(122,0,20,1);

}

}


@keyframes silverShine{

0%{
left:-120%;
}

100%{
left:180%;
}

}



/*====================================
        MAIN CONTAINER
====================================*/


.testimonials{

background:

linear-gradient(
135deg,
#120002,
#45000c,
#7a0014);

padding:45px 30px;

border-radius:25px;

position:relative;

overflow:hidden;

border:2px solid #d9d9d9;

animation:
premiumGlow 4s infinite ease-in-out;

box-shadow:

0 0 30px rgba(122,0,20,.8);

}



/* SILVER SHINE */

.testimonials::before{

content:"";

position:absolute;

top:-50%;
left:-120%;

width:60%;
height:250%;

background:

linear-gradient(
90deg,
transparent,
rgba(255,255,255,.5),
transparent);

transform:rotate(25deg);

animation:
silverShine 7s linear infinite;

pointer-events:none;

}



/*====================================
             TITLE
====================================*/


.testimonials h2{

text-align:center;

font-size:2.3rem;

font-weight:900;

letter-spacing:2px;

text-transform:uppercase;

margin-bottom:40px;

background:

linear-gradient(
135deg,
#ffffff,
#d9d9d9,
#7a0014);

-webkit-background-clip:text;
-webkit-text-fill-color:transparent;

text-shadow:

0 0 20px rgba(255,255,255,.5);

}


.testimonials h2::before,
.testimonials h2::after{

content:"";

display:block;

margin:auto;

background:

linear-gradient(
90deg,
transparent,
#d9d9d9,
transparent);

}


.testimonials h2::before{

width:180px;
height:3px;

margin-top:8px;

}


.testimonials h2::after{

width:100px;
height:2px;

margin-top:6px;

}



/*====================================
               GRID
====================================*/


.testi-grid{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(320px,1fr));

gap:25px;

}



/*====================================
              CARD
====================================*/


.testi-card{

background:

linear-gradient(
145deg,
#180003,
#45000c);

padding:25px;

border-radius:20px;

border:1px solid
rgba(255,255,255,.15);

position:relative;

overflow:hidden;

transition:.4s;

box-shadow:

0 0 20px rgba(122,0,20,.5);

}



.testi-card:hover{

transform:
translateY(-8px)
scale(1.02);

box-shadow:

0 0 25px rgba(255,255,255,.4),
0 0 45px rgba(122,0,20,.9);

border-color:#d9d9d9;

}



/* SILVER CORNER */

.testi-card::before{

content:"";

position:absolute;

top:0;
right:0;

width:18px;
height:18px;

background:

linear-gradient(
135deg,
#ffffff,
#d9d9d9);

clip-path:

polygon(
100% 0,
0 0,
100% 100%);

}



/*====================================
            AVATAR
====================================*/


.avatar{

width:55px;
height:55px;

border-radius:15px;

background:

linear-gradient(
135deg,
#ffffff,
#d9d9d9,
#7a0014);

color:#7a0014;

font-size:1.3rem;
font-weight:900;

display:grid;
place-items:center;

border:2px solid #ffffff;

box-shadow:

0 0 15px rgba(255,255,255,.5);

transition:.4s;

}


.testi-card:hover .avatar{

transform:
scale(1.1);

}



/*====================================
             HEADER
====================================*/


.testi-head{

display:flex;

gap:15px;

align-items:center;

padding-bottom:15px;

margin-bottom:15px;

border-bottom:

1px solid
rgba(255,255,255,.1);

}



/*====================================
              TEXT
====================================*/


.name{

font-size:1.15rem;

font-weight:800;

color:#ffffff;

margin:0;

}


.meta{

font-size:.80rem;

color:#d9d9d9;

margin-top:5px;

text-transform:uppercase;

font-weight:700;

}


.meta span{

padding:3px 8px;

border-radius:30px;

background:

rgba(255,255,255,.08);

margin-left:5px;

}



.quote{

font-size:.95rem;

