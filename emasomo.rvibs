<style>
.button-login-daftar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    font-weight: 700;
    gap: 8px;
}

.button-login-daftar a {
    text-align: center;
    text-decoration: none;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    transition: all .4s ease;
}

.login,
.register {
    color: #ffffff;
    padding: 15px 10px;
    font-size: 15px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 700;
}

/* WARNA PREMIUM MAROON + SILVER */
.login,
.login-button,
.register,
.register-button {
    background: linear-gradient(
        135deg,
        #3b0008 0%,
        #7a0014 25%,
        #c0c0c0 50%,
        #7a0014 75%,
        #3b0008 100%
    );
    border: 2px solid #d8d8d8;
    box-shadow:
        0 0 8px rgba(255,255,255,.4),
        0 0 15px rgba(192,192,192,.5),
        0 0 25px rgba(122,0,20,.8),
        inset 0 0 10px rgba(255,255,255,.25);
}

/* EFEK GLOW PREMIUM */
.button-login-daftar a:hover {
    transform: translateY(-3px);
    box-shadow:
        0 0 15px rgba(255,255,255,.8),
        0 0 25px rgba(192,192,192,.8),
        0 0 40px rgba(122,0,20,1),
        0 0 60px rgba(122,0,20,.8);
}

/* EFEK KILAU BERJALAN */
.button-login-daftar a::before {
    content: "";
    position: absolute;
    top: -50%;
    left: -100%;
    width: 60%;
    height: 200%;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.6),
        transparent
    );
    transform: rotate(25deg);
    animation: shine 3s linear infinite;
}

@keyframes shine {
    0% {
        left: -120%;
    }
    100% {
        left: 180%;
    }
}

/* EFEK GLOW TEKS */
.login,
.register {
    text-shadow:
        0 0 5px #ffffff,
        0 0 10px #d9d9d9,
        0 0 15px #7a0014;
}
</style>
                
