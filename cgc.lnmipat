<style>

/* =========================================================
   BLOOD RED × SILVER SNOW
   ========================================================= */

.ko-global-snow {

  position: fixed;

  top: 0;
  left: 0;

  width: 100vw;
  height: 100vh;

  pointer-events: none;

  overflow: hidden;

  z-index: 999999;

  background: transparent;
}


/* =========================================================
   BASE SNOW
   ========================================================= */

.ko-snow {

  position: absolute;

  top: -30px;

  width: 8px;
  height: 8px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 30% 30%,
      #ffffff 0%,
      #eeeeee 35%,
      #c0c0c0 65%,
      #777777 100%
    );

  box-shadow:
    0 0 5px rgba(255,255,255,.8),
    0 0 10px rgba(192,192,192,.45);

  opacity: 0;

  animation:
    silverSnowFall
    9s
    linear
    infinite;

  will-change:
    transform,
    opacity;

}


/* =========================================================
   VARIASI BLOOD RED
   ========================================================= */

.ko-snow:nth-child(4n) {

  background:
    radial-gradient(
      circle,
      #eeeeee 0%,
      #c0c0c0 35%,
      #8b0000 70%,
      #450000 100%
    );

  box-shadow:
    0 0 5px rgba(192,192,192,.7),
    0 0 10px rgba(139,0,0,.7);

}


/* =========================================================
   UKURAN & POSISI
   ========================================================= */

.s1 {
  left: 4%;
  width: 6px;
  height: 6px;
  animation-duration: 8s;
  animation-delay: 0s;
}

.s2 {
  left: 11%;
