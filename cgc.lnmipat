}


.toto-4d-faq-title3 {
  color: #bdbdbd;

  font-size: 30px;

  margin-top: 15px;
  margin-bottom: 15px;

  font-weight: 800;

  font-family: "Segoe UI", sans-serif;

  text-shadow:
    0 0 8px rgba(192,192,192,.5),
    0 0 18px rgba(139,0,0,.8),
    0 0 25px #000;

  letter-spacing: 1.5px;
}


/* =========================================
   FAQ CONTAINER
   ========================================= */

.cok-faq {
  max-width: 1200px;

  margin: 10px auto 40px auto;

  font-family: "Segoe UI", sans-serif;

  padding: 15px;

  background:
    linear-gradient(
      180deg,
      #0b0b0b 0%,
      #050505 55%,
      #000000 100%
    );

  border-radius: 24px;

  border: 2px solid #777777;

  animation:
    rgbBorder 6s linear infinite,
    neonGlow 3s ease-in-out infinite;

  box-shadow:
    0 10px 30px rgba(0,0,0,.7);
}


/* =========================================
   QUESTION BUTTON
   ========================================= */

.cok-faq-q {
  width: 100%;

  padding: 16px 20px;

  background:
    linear-gradient(
      135deg,
      #8b0000 0%,
      #4a0000 48%,
      #170000 100%
    );

  color: #ffffff !important;

  font-weight: 800;

  border: 1px solid #bdbdbd;

  border-radius: 16px;

  cursor: pointer;

  text-align: left;

  margin-bottom: 10px;

  font-size: 18px;

  letter-spacing: 0.5px;

  position: relative;

  overflow: hidden;

  transition:
    all 0.4s
    cubic-bezier(
      0.175,
      0.885,
      0.32,
      1.275
    );

  box-shadow:
    0 4px 15px rgba(0,0,0,.55),
    0 0 8px rgba(139,0,0,.35);
}


/* =========================================
   QUESTION HOVER
   ========================================= */

.cok-faq-q:hover {

  background:
    linear-gradient(
      to bottom,
      #b30000 0%,
      #350000 50%,
      #700000 100%
    );

  transform:
    translateY(-3px)
    scale(1.01);

  box-shadow:
    0 0 15px rgba(139,0,0,.9),
    0 0 30px rgba(139,0,0,.55),
    inset 0 0 10px rgba(192,192,192,.15);

  border-color: #e0e0e0;
}


/* =========================================
   MODERN ARROW
   ========================================= */

.cok-faq-q::after {

  content: '▾';

  position: absolute;

  right: 20px;

  top: 50%;

  transform:
    translateY(-50%);

  font-size: 16px;

  color: #d0d0d0;

  transition:
    transform 0.4s ease,
    color 0.3s ease;

  text-shadow:
    0 0 6px rgba(192,192,192,.7);
}


/* =========================================
   ANSWER BOX
   ========================================= */

.cok-faq-a {

  max-height: 0;

  overflow: hidden;

  background:
    linear-gradient(
      180deg,
      #101010,
      #070707
    );

  color: #dddddd;

  margin-top: -12px;

  margin-bottom: 12px;

  border-radius:
    0 0 16px 16px;

  padding: 0 20px;

  border-left:
    2px solid #8b0000;

  border-right:
    2px solid #8b0000;

  border-bottom:
    2px solid #8b0000;

  transition:
    max-height 0.5s
      cubic-bezier(0, 1, 0, 1),

    padding 0.3s ease,

    box-shadow 0.3s ease;

  font-size: 16px;

  line-height: 1.6;
}


/* =========================================
   OPEN ANSWER
   ========================================= */

.cok-faq-a.open {

  max-height: 1000px;

  padding: 20px;

  box-shadow:
    inset 0 0 20px
      rgba(139,0,0,.18),

    inset 0 -2px 8px
      rgba(192,192,192,.08),

    0 5px 15px
      rgba(0,0,0,.6);
}


/* =========================================
   RESPONSIVE
   ========================================= */

@media (max-width: 480px) {

  .toto-4d-faq-title {
    font-size: 26px;
  }

  .toto-4d-faq-title2 {
    font-size: 30px;
  }

  .toto-4d-faq-title3 {
    font-size: 24px;
  }

  .cok-faq {
    padding: 10px;
    border-radius: 18px;
  }

  .cok-faq-q {

    font-size: 16px;

    padding: 14px 15px;

    border-radius: 13px;
  }

  .cok-faq-a {
    font-size: 14.5px;
    line-height: 1.6;
  }

}

</style>
      
<style>
/* =====================================================
   BLOOD RED + SILVER CYBER TESTIMONIALS
   ===================================================== */

/* === KEYFRAMES === */

@keyframes cyberGlow {
  0% {
    box-shadow:
      0 0 5px rgba(139, 0, 0, 0.4),
      inset 0 0 5px rgba(139, 0, 0, 0.2);
  }

  50% {
    box-shadow:
      0 0 20px rgba(179, 0, 0, 0.8),
      0 0 30px rgba(192, 192, 192, 0.18),
      inset 0 0 15px rgba(139, 0, 0, 0.5);
  }

  100% {
    box-shadow:
      0 0 5px rgba(139, 0, 0, 0.4),
      inset 0 0 5px rgba(139, 0, 0, 0.2);
  }
}


@keyframes scanline {
  0% {
    transform: translateY(-100%);
  }

  100% {
    transform: translateY(100%);
  }
}


@keyframes borderPulse {
  0% {
    border-color: #777777;
  }

  50% {
    border-color: #b30000;
  }

  100% {
    border-color: #777777;
  }
}


/* =====================================================
   MAIN TESTIMONIAL CONTAINER
   ===================================================== */

.testimonials {
  background: #070707;

  color: #e5e5e5;

  font-family:
    "Segoe UI",
    system-ui,
    -apple-system,
    sans-serif;

  padding: 45px 30px;

  border-radius: 24px;

  position: relative;

  overflow: hidden;

  border: 2px solid #777777;

  /*
   * Dark cyber grid
   */
  background-image:
    linear-gradient(
      rgba(139, 0, 0, 0.055) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(192, 192, 192, 0.035) 1px,
      transparent 1px
    );

  background-size: 20px 20px;

  box-shadow:
    0 0 30px rgba(139, 0, 0, 0.22);

  animation:
    cyberGlow 4s ease-in-out infinite;
}


/* =====================================================
   TITLE
   ===================================================== */

.testimonials h2 {

  text-align: center;

  font-size: 2.3rem;

  margin-bottom: 40px;

  font-weight: 900;

  letter-spacing: 2px;

  text-transform: uppercase;

  /*
   * SILVER METALLIC TEXT
   */
  background:
    linear-gradient(
      to bottom,
      #ffffff 0%,
      #c0c0c0 45%,
      #777777 55%,
      #eeeeee 100%
    );

  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;

  position: relative;

  display: block;

  text-shadow:
    2px 2px 0 rgba(0, 0, 0, 0.8);
}


/* =====================================================
   DECORATIVE TITLE LINES
   ===================================================== */

.testimonials h2::before,
.testimonials h2::after {

  content: '';

  display: block;

  margin: 8px auto;

  height: 3px;

  background:
    linear-gradient(
      90deg,
      transparent,
      #8b0000,
      #c0c0c0,
      #8b0000,
      transparent
    );

  box-shadow:
    0 0 10px rgba(139, 0, 0, 0.8);
}


.testimonials h2::before {
  width: 180px;
}


.testimonials h2::after {

  width: 90px;

  height: 2px;

  margin-top: -4px;

  background:
    linear-gradient(
      90deg,
      transparent,
      #b30000,
      #d0d0d0,
      #b30000,
      transparent
    );
}


/* =====================================================
   GRID
   ===================================================== */

.testi-grid {

  display: grid;

  grid-template-columns:
    repeat(
      auto-fit,
      minmax(320px, 1fr)
    );

  gap: 25px;

  position: relative;

  z-index: 2;
}


/* =====================================================
   TESTIMONIAL CARD
   ===================================================== */

.testi-card {

  background:
    linear-gradient(
      145deg,
      #151515 0%,
      #0a0a0a 55%,
      #050505 100%
    );

  border-radius: 16px;

  padding: 25px;

  border:
    1px solid rgba(192, 192, 192, 0.18);

  border-left:
    4px solid #8b0000;

  position: relative;

  overflow: hidden;

  transition:
    all 0.4s
    cubic-bezier(
      0.165,
      0.84,
      0.44,
      1
    );

  box-shadow:
    0 8px 20px rgba(0, 0, 0, 0.55);
}


/* =====================================================
   CYBER CORNER ORNAMENT
   ===================================================== */

.testi-card::before {

  content: '';

  position: absolute;

  top: 0;
  right: 0;

  width: 15px;
  height: 15px;

  background:
    linear-gradient(
      135deg,
      #d0d0d0,
      #777777 45%,
      #8b0000 46%,
      #b30000
    );

  clip-path:
    polygon(
      100% 0,
      0 0,
      100% 100%
    );

  box-shadow:
    0 0 10px rgba(139, 0, 0, 0.5);
}


/* =====================================================
   HOVER CARD
   ===================================================== */

.testi-card:hover {

  transform:
    translateY(-8px)
    scale(1.02);

  border-color:
    #bdbdbd;

  border-left-color:
    #b30000;

  box-shadow:
    0 15px 30px rgba(0, 0, 0, 0.7),
    0 0 18px rgba(139, 0, 0, 0.45),
    0 0 10px rgba(192, 192, 192, 0.12);
}


/* =====================================================
   LASER SCAN EFFECT
   ===================================================== */

.testi-card::after {

  content: '';

  position: absolute;

  top: 0;
  left: 0;
  right: 0;
  bottom: 0;

  background:
    linear-gradient(
      to bottom,
      transparent 50%,
      rgba(139, 0, 0, 0.10) 50%
    );

  background-size:
    100% 4px;

  opacity: 0;

  pointer-events: none;

  transition:
    opacity 0.3s ease;
}


.testi-card:hover::after {
  opacity: 1;
}


/* =====================================================
   AVATAR / HEAD
   ===================================================== */

.testi-head {

  display: flex;

  align-items: center;

  gap: 15px;

  margin-bottom: 18px;

  border-bottom:
    1px dashed
    rgba(192, 192, 192, 0.15);

  padding-bottom: 12px;
}


/* =====================================================
   AVATAR
   ===================================================== */

.avatar {

  width: 50px;
  height: 50px;

  border-radius: 12px;

  transform: rotate(-5deg);

  background:
    linear-gradient(
      135deg,
      #d8d8d8 0%,
      #888888 40%,
      #350000 41%,
      #8b0000 100%
    );

  color: #ffffff;

  font-weight: 900;

  font-size: 1.3rem;

  display: grid;

  place-items: center;

  border:
    2px solid #c0c0c0;

  box-shadow:
    0 0 10px rgba(139, 0, 0, 0.6),
    0 0 5px rgba(192, 192, 192, 0.25);

  text-shadow:
    0 0 5px #ffffff;

  transition:
    transform 0.3s ease;
}


.testi-card:hover .avatar {

  transform:
    rotate(0deg)
    scale(1.1);
}


/* =====================================================
   NAME
   ===================================================== */

.name {

  font-size: 1.15rem;

  margin: 0;

  font-weight: 800;

  color: #ffffff;

  letter-spacing: 0.5px;
}


.testi-card:hover .name {

  color: #d0d0d0;

  text-shadow:
    0 0 8px rgba(192, 192, 192, 0.45);
}


/* =====================================================
   META
   ===================================================== */

.meta {

  font-size: 0.8rem;

  color: #b30000;

  margin: 3px 0 0 0;

  font-weight: 600;

  text-transform: uppercase;
}


/* LOCATION */

.meta span[itemprop="name"] {

  color: #a5a5a5;

  margin-left: 5px;

  background:
    rgba(192, 192, 192, 0.06);

  padding:
    2px 6px;

  border-radius: 4px;

  font-size: 0.75rem;

  border:
    1px solid
    rgba(192, 192, 192, 0.12);
}


/* =====================================================
   QUOTE / REVIEW
   ===================================================== */

.quote {

  font-size: 0.95rem;

  line-height: 1.7;

  color: #d1d1d1;

  margin: 12px 0 0 0;

  position: relative;

  z-index: 3;
}


/* =====================================================
   DECORATIVE QUOTE
   ===================================================== */

.quote::before {

  content: '“';

  position: absolute;

  top: -20px;

  left: -10px;

  font-size: 4rem;

  color:
    rgba(139, 0, 0, 0.16);

  font-family: serif;

  z-index: -1;
}


/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 768px) {

  .testimonials {

    padding:
      30px 15px;

  }

  .testimonials h2 {

    font-size:
      1.8rem;

  }

  .testi-grid {

    grid-template-columns:
      1fr;

    gap: 20px;

  }

}
</style>   

  </div>

  <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span></div>

  <br>
  <br>

  <script>
            document.addEventListener('DOMContentLoaded',
             function(){const faqItems=document.querySelectorAll('.faq-item');
             faqItems.forEach(item=>{const question=item.querySelector('.faq-question');
             question.addEventListener('click',
             ()=>{const isActive=item.classList.contains('active');
             faqItems.forEach(otherItem=>{otherItem.classList.remove('active')});
             if(!isActive){item.classList.add('active')}})})});
         </script>
 

<!-- ========================= JS ========================= -->

<script>
document.querySelectorAll(".cok-faq-q").forEach(btn => {
  btn.addEventListener("click", () => {
    let answer = btn.nextElementSibling;
    answer.classList.toggle("open");
  });
});
</script>
