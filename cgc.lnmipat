/* =========================================
   BLOOD RED × SILVER POPUP
   ========================================= */

.TOTO {
  margin: 0;
  padding: 0;
  font-family: 'Playfair Display', 'Segoe UI', serif;
  background-color: transparent;
  color: #eeeeee;
  overflow: hidden;
}


/* =========================================
   OVERLAY
   ========================================= */

.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;

  background: rgba(0, 0, 0, 0.72);

  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);

  display: flex;
  justify-content: center;
  align-items: center;

  z-index: 9999;
}


/* =========================================
   POPUP CONTAINER
   ========================================= */

.popup-container {
  position: relative;

  width: 90%;
  max-width: 420px;

  font-style: italic;

  background:
    linear-gradient(
      145deg,
      rgba(18, 18, 18, 0.97),
      rgba(5, 5, 5, 0.98)
    );

  border-radius: 20px;

  overflow: hidden;

  text-align: center;

  animation:
    rotateScaleIn 0.8s
      cubic-bezier(0.175, 0.885, 0.32, 1.275),
    bloodPulse 3.5s
      infinite ease-in-out;

  box-shadow:
    0 20px 40px rgba(0, 0, 0, 0.85),
    0 0 20px rgba(139, 0, 0, 0.35),
    0 0 0 1px rgba(192, 192, 192, 0.18);

  padding-bottom: 20px;

  border:
    1px solid
    rgba(192, 192, 192, 0.35);

  backdrop-filter:
    blur(10px);

  -webkit-backdrop-filter:
    blur(10px);
}


/* =========================================
   SILVER DIAGONAL SHINE
   ========================================= */

.popup-container::before {

  content: "";

  position: absolute;

  top: -100%;
  left: -100%;

  width: 200%;
  height: 200%;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,0) 45%,
      rgba(220,220,220,0.14) 50%,
      rgba(255,255,255,0) 55%
    );

  animation:
    shineDiagonal 5s linear infinite;

  z-index: 2;

  pointer-events: none;
}


@keyframes shineDiagonal {

  0% {
    transform:
      translate(-100%, -100%)
      rotate(30deg);
  }

  100% {
    transform:
      translate(100%, 100%)
      rotate(30deg);
  }

}


/* =========================================
   BLOOD PULSE
   ========================================= */

@keyframes bloodPulse {

  0%, 100% {

    box-shadow:
      0 20px 40px rgba(0,0,0,.85),
      0 0 15px rgba(139,0,0,.25),
      0 0 0 1px rgba(192,192,192,.15);

  }

  50% {

    box-shadow:
      0 20px 40px rgba(0,0,0,.85),
      0 0 28px rgba(139,0,0,.55),
      0 0 45px rgba(80,0,0,.25),
      0 0 0 1px rgba(220,220,220,.35);

  }

}


/* =========================================
   POPUP IMAGE
   ========================================= */

.popup-image {

  width: 100%;

  display: block;

  border-bottom:
    1px solid
    rgba(192,192,192,.25);

  filter:
    contrast(1.05)
    saturate(.9);
}


/* =========================================
   BUTTON AREA
   ========================================= */

.clk-btn-sgp {

  width: 97%;

  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 15px;

  font-family:
    'Poppins',
    sans-serif;

  font-weight: 700;

  padding: 20px;

  position: relative;

  overflow: hidden;
}


/* SILVER ACCENT LINE */

.clk-btn-sgp::before {

  content: '';

  position: absolute;

  top: 50%;
  left: 50%;

  transform:
    translate(-50%, -50%);

  width:
    calc(100% - 30px);

  height: 2px;

  background:
    linear-gradient(
      to right,
      #555555,
      #eeeeee,
      #777777,
      #eeeeee,
      #555555
    );

  opacity: .4;

  filter:
    blur(1px);
}


/* =========================================
   BUTTON BASE
   ========================================= */

.clk-btn-sgp a {

  text-align: center;

  text-transform: uppercase;

  letter-spacing: 1.5px;

  padding:
    16px 12px;

  margin: 0;

  border-radius: 14px;

  transition:
    all .4s
    cubic-bezier(.23,1,.32,1);

  position: relative;

  overflow: hidden;

  backdrop-filter:
    blur(10px);

  -webkit-backdrop-filter:
    blur(10px);

  border:
    2px solid transparent;

  box-shadow:
    0 8px 0 #000;

  clip-path:
    polygon(
      var(--blade-cut, 10px) 0%,
      100% 0%,
      100% calc(100% - var(--blade-cut, 10px)),
      calc(100% - var(--blade-cut, 10px)) 100%,
      0% 100%,
      0% var(--blade-cut, 10px)
    );

  z-index: 1;
}


/* =========================================
   SILVER BORDER HOVER
   ========================================= */

.clk-btn-sgp a::after {

  content: '';

  position: absolute;

  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;

  background:
    linear-gradient(
      135deg,
      #eeeeee 0%,
      #777777 25%,
      #eeeeee 50%,
      #555555 75%,
      #eeeeee 100%
    );

  border-radius: 16px;

  z-index: -1;

  opacity: 0;

  transition:
    opacity .3s ease;
}


.clk-btn-sgp a:hover::after {

  opacity: 1;

}


.clk-btn-sgp a:hover {

  transform:
    translateY(-6px)
    scale(1.03);

  border-color:
    #c0c0c0;

}


/* =========================================
   LOGIN — BLOOD RED
   ========================================= */

.login {

  color:
    #eeeeee !important;

  background:
    linear-gradient(
      145deg,
      #420000,
      #160000 55%,
      #050505
    );

  border:
    2px solid #777777;

  text-shadow:
    0 2px 4px rgba(0,0,0,.8);

  position: relative;
}


.login::before {

  position: absolute;

  left: 15px;

  top: 50%;

  transform:
    translateY(-50%);

  font-size: 18px;

  opacity: .7;

  transition:
    all .3s ease;

  filter:
    drop-shadow(
      0 0 5px #bdbdbd
    );
}


.login:hover {

  background:
    linear-gradient(
      145deg,
      #650000,
      #280000,
      #080000
    );

  box-shadow:
    0 12px 0 #000,
    0 20px 40px rgba(139,0,0,.55),
    0 0 30px rgba(139,0,0,.35);

  color:
    #ffffff !important;

  border-color:
    #d0d0d0;
}


.login:hover::before {

  opacity: 1;

  transform:
    translateY(-50%)
    rotate(15deg);

  filter:
    drop-shadow(
      0 0 8px #eeeeee
    );
}


/* =========================================
   REGISTER — SILVER / BLOOD
   ========================================= */

.register {

  color:
    #eeeeee !important;

  background:
    linear-gradient(
      145deg,
      #333333,
      #151515 55%,
      #050505
    );

  border:
    2px solid #8c8c8c;

  text-shadow:
    0 1px 2px rgba(255,255,255,.2);

  position: relative;
}


.register::before {

  position: absolute;

  right: 15px;

  top: 50%;

  transform:
    translateY(-50%);

  font-size: 18px;

  opacity: .7;

  transition:
    all .3s ease;

  filter:
    drop-shadow(
      0 0 5px
      rgba(192,192,192,.6)
    );
}


.register:hover {

  background:
    linear-gradient(
      145deg,
      #4d0000,
      #210000,
      #080000
    );

  box-shadow:
    0 12px 0 #000,
    0 20px 40px rgba(139,0,0,.55),
    0 0 35px rgba(192,192,192,.18);

  color:
    #ffffff !important;

  border-color:
    #eeeeee;
}


.register:hover::before {

  opacity: 1;

  transform:
    translateY(-50%)
    scale(1.2)
    rotate(360deg);

  filter:
    drop-shadow(
      0 0 7px
      #eeeeee
    );
}


/* =========================================
   BUTTON TEXT
   ========================================= */

.clk-btn-sgp a span {

  display:
    inline-block;

  transition:
    transform .3s ease;
}


.clk-btn-sgp a:hover span {

  transform:
    translateX(3px);

}


/* =========================================
   INFO TABLE
   ========================================= */

.info-togel-online-table {

  width: 90%;

  margin: 20px auto;

  border-collapse:
    collapse;

  color:
    #eeeeee;

  font-size:
    14px;

  position:
    relative;

  z-index: 3;

  background:
    rgba(0,0,0,.45);

  border-radius:
    10px;

  overflow:
    hidden;

  box-shadow:
    0 5px 15px rgba(0,0,0,.5);
}


/* TABLE HEADER */

.info-togel-online-table th {

  background:
    linear-gradient(
      135deg,
      #eeeeee 0%,
      #999999 35%,
      #4a0000 52%,
      #190000 70%,
      #bdbdbd 100%
    );

  padding:
    14px 10px;

  font-size:
    15px;

  color:
    #080808;

  border:
    none;

  font-weight:
    700;

  letter-spacing:
    .8px;

  text-transform:
    uppercase;
}


/* TABLE DATA */

.info-togel-online-table td {

  padding:
    12px;

  border-bottom:
    1px solid
    rgba(192,192,192,.12);

  text-align:
    left;
}


.info-togel-online-table tr:last-child td {

  border-bottom:
    none;

}


/* =========================================
   FOOTER
   ========================================= */

.popup-footer {

  font-size:
    13px;

  color:
    #c5c5c5;

  padding:
    20px 10px;

  position:
    relative;

  z-index:
    3;

  line-height:
    1.6;

  font-family:
    'Playfair Display',
    serif;
}


/* =========================================
   POPUP ENTRANCE
   ========================================= */

@keyframes rotateScaleIn {

  0% {

    opacity: 0;

    transform:
      scale(.3)
      rotate(-10deg);

  }

  50% {

    transform:
      scale(1.05)
      rotate(2deg);

  }

  100% {

    opacity: 1;

    transform:
      scale(1)
      rotate(0deg);

  }

}


/* =========================================
   SILVER PARTICLES
   ========================================= */

.gold-particle {

  position:
    absolute;

  background:
    radial-gradient(
      circle,
      #ffffff 0%,
      #c0c0c0 45%,
      #555555 100%
    );

  border-radius:
    50%;

  pointer-events:
    none;

  z-index:
    1;

  animation:
    floatSilver
    10s
    infinite
    ease-in-out;

  box-shadow:
    0 0 10px
    rgba(192,192,192,.7);
}


@keyframes floatSilver {

  0%, 100% {

    transform:
      translateY(0)
      translateX(0);

    opacity: 0;

  }

  10% {

    opacity: .8;

  }

  90% {

    opacity: .8;

  }

  100% {

    transform:
      translateY(-120px)
      translateX(40px);

    opacity: 0;

  }

}


/* =========================================
   LUXURY BORDER
   ========================================= */

.luxury-border {

  position:
    absolute;

  top: 0;
  left: 0;
  right: 0;
  bottom: 0;

  border:
    1px solid
    rgba(192,192,192,.3);

  border-radius:
    20px;

  pointer-events:
    none;

  z-index:
    4;

  background:
    linear-gradient(
      135deg,
      rgba(192,192,192,0) 0%,
      rgba(192,192,192,.08) 50%,
      rgba(139,0,0,.08) 70%,
      rgba(192,192,192,0) 100%
    );
}


/* =========================================
   CLOSE BUTTON
   ========================================= */

.close-btn {

  position:
    absolute;

  top: 15px;
  right: 15px;

  width:
    32px;

  height:
    32px;

  background:
    rgba(0,0,0,.7);

  border-radius:
    50%;

  display:
    flex;

  justify-content:
    center;

  align-items:
    center;

  cursor:
    pointer;

  z-index:
    10;

  transition:
    all .3s ease;

  border:
    1px solid
    rgba(192,192,192,.5);

  box-shadow:
    0 0 8px
    rgba(139,0,0,.4);
}


.close-btn:hover {

  background:
    linear-gradient(
      135deg,
      #eeeeee,
      #888888
    );

  border-color:
    #8b0000;

  transform:
    rotate(90deg);

  box-shadow:
    0 0 15px
    rgba(192,192,192,.7),
    0 0 20px
    rgba(139,0,0,.45);
}


/* CLOSE X */

.close-btn::before,
.close-btn::after {

  content: '';

  position:
    absolute;

  width:
    16px;

  height:
    2px;

  background:
    #eeeeee;
}


.close-btn::before {

  transform:
    rotate(45deg);

}


.close-btn::after {

  transform:
    rotate(-45deg);

}


/* =========================================
   RESPONSIVE
   ========================================= */

@media (max-width: 768px) {

  .clk-btn-sgp {

    grid-template-columns:
      1fr;

    gap:
      12px;

  }

  .clk-btn-sgp a {

    padding:
      18px 12px;

  }

  .login::before,
  .register::before {

    position:
      relative;

    left: 0;
    right: 0;

    display:
      inline-block;

    margin-right:
      10px;

    transform:
      none;

    top: 0;
  }

  .login:hover::before,
  .register:hover::before {

    transform:
      none;

  }

}


@media (max-width: 480px) {

  .popup-container {

    width:
      95%;

    max-width:
      350px;

  }

  .popup-buttons a {

    font-size:
      14px;

    padding:
      16px 0;

  }

  .info-togel-online-table {

    font-size:
      13px;

  }

  .popup-footer {

    font-size:
      12px;

  }

  .close-btn {

    width:
      28px;

    height:
      28px;

  }

}

</style>
