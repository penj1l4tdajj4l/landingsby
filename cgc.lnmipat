/* =========================================
   BLOOD RED + SILVER
   GLITCH / NEON ANIMATIONS
   ========================================= */

@keyframes neonGlow {
  0% {
    box-shadow:
      0 0 5px #8b0000,
      0 0 10px #8b0000,
      inset 0 0 5px #8b0000;
  }

  50% {
    box-shadow:
      0 0 15px #b30000,
      0 0 28px #b30000,
      inset 0 0 10px #b30000;
  }

  100% {
    box-shadow:
      0 0 5px #8b0000,
      0 0 10px #8b0000,
      inset 0 0 5px #8b0000;
  }
}


@keyframes rgbBorder {
  0% {
    border-color: #777777;
  }

  33% {
    border-color: #b30000;
  }

  66% {
    border-color: #d0d0d0;
  }

  100% {
    border-color: #777777;
  }
}


