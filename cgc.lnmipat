/* =========================================
   PRODUCT RECOMMENDED
   BLACK × BLOOD RED × SILVER
   ========================================= */

.product-recommended {
  background:
    linear-gradient(
      145deg,
      #080808 0%,
      #030303 55%,
      #000000 100%
    );

  padding: 35px 20px;

  border-radius: 18px;

  border: 2px solid #888888;

  box-shadow:
    0 0 20px rgba(139, 0, 0, 0.35),
    inset 0 0 20px rgba(139, 0, 0, 0.06);

  position: relative;

  overflow: hidden;
}


/* =========================================
   GLOBAL SILVER SHINE
   ========================================= */

.product-recommended::before {

  content: "";

  position: absolute;

  top: 0;

  left: -120%;

  width: 60%;

  height: 100%;

  background:
    linear-gradient(
      120deg,
      transparent,
      rgba(220, 220, 220, 0.22),
      transparent
    );

  transform: skewX(-25deg);

  animation:
    shineMove 5s infinite;

  pointer-events: none;
}


@keyframes shineMove {

  0% {
    left: -120%;
  }

  100% {
    left: 150%;
  }

}


/* =========================================
   TITLE
   ========================================= */

.product-recommended-title {

  text-align: center;

  background:
    linear-gradient(
