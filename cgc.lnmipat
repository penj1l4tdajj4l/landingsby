  animation-delay: 1.5s;
}

.s8 {
  left: 61%;
  width: 8px;
  height: 8px;
  animation-duration: 10s;
  animation-delay: 4.5s;
}

.s9 {
  left: 69%;
  width: 5px;
  height: 5px;
  animation-duration: 7s;
  animation-delay: 2.5s;
}

.s10 {
  left: 76%;
  width: 10px;
  height: 10px;
  animation-duration: 11s;
  animation-delay: 6s;
}

.s11 {
  left: 83%;
  width: 6px;
  height: 6px;
  animation-duration: 8.5s;
  animation-delay: 3.5s;
}

.s12 {
  left: 90%;
  width: 8px;
  height: 8px;
  animation-duration: 10s;
  animation-delay: 5.5s;
}

.s13 {
  left: 96%;
  width: 5px;
  height: 5px;
  animation-duration: 7.5s;
  animation-delay: 1s;
}

.s14 {
  left: 32%;
  width: 7px;
  height: 7px;
  animation-duration: 9.5s;
  animation-delay: 6.5s;
}

.s15 {
  left: 72%;
  width: 4px;
  height: 4px;
  animation-duration: 6.5s;
  animation-delay: 2s;
}


/* =========================================================
   ANIMASI SALJU
   ========================================================= */

@keyframes silverSnowFall {

  0% {

    transform:
      translate3d(0, -40px, 0)
      rotate(0deg)
      scale(.7);

    opacity: 0;

  }

  10% {

    opacity: .9;

  }

  30% {

    transform:
      translate3d(35px, 30vh, 0)
      rotate(120deg)
      scale(1);

    opacity: .75;

  }

  55% {

    transform:
      translate3d(-25px, 60vh, 0)
      rotate(240deg)
      scale(.9);

    opacity: .8;

  }

  80% {

    transform:
      translate3d(30px, 90vh, 0)
      rotate(330deg)
      scale(1.05);

    opacity: .55;

  }

  100% {

    transform:
      translate3d(-20px, 115vh, 0)
      rotate(450deg)
      scale(.7);

    opacity: 0;

  }

}


/* =========================================================
   MARQUEE — BLOOD RED × SILVER
   ========================================================= */

.m-top-banner {

  width: 100%;

  padding: 10px 0;

  background:
    #050505;

  box-sizing:
    border-box;
}


/* =========================================================
   MARQUEE CONTAINER
   ========================================================= */

.neon-marquee-container {

  position: relative;

  width: 95%;

  margin: 0 auto;

  padding: 10px 0;

  background:
    linear-gradient(
      180deg,
      #111111,
      #050505
    );

  border:
    2px solid #888888;

  border-radius:
    6px;

  overflow:
    hidden;

  animation:
    bloodSilverBorder
    4s
    linear
    infinite;

}


/* =========================================================
   MARQUEE TRACK
   ========================================================= */

.marquee-track {

  display:
    flex;

  align-items:
    center;

  gap:
    15px;

  width:
    max-content;

  min-width:
    100%;

  animation:
    jalanTerus
    15s
    linear
    infinite;

}


/* =========================================================
   MARQUEE TEXT
   ========================================================= */

.marquee-track .marquee-text {

  color:
    #eeeeee;

  font-family:
    sans-serif;

  font-weight:
    bold;

  font-size:
    14px;

  letter-spacing:
    1px;

  white-space:
    nowrap;

  text-shadow:
    0 0 6px rgba(192,192,192,.35);

}


/* =========================================================
   ICON
   ========================================================= */

.marquee-track .free-shipping__icon img {

  display:
    inline-block;

  vertical-align:
    middle;

  filter:
    drop-shadow(
      0 0 5px
      rgba(192,192,192,.55)
    );

}


/* =========================================================
   MARQUEE MOVEMENT
   ========================================================= */

@keyframes jalanTerus {

  0% {

    transform:
      translateX(100vw);

  }

  100% {

    transform:
      translateX(-100%);

  }

}


/* =========================================================
   BLOOD × SILVER BORDER
   ========================================================= */

@keyframes bloodSilverBorder {

  0%,
  100% {

    border-color:
      #c0c0c0;

    box-shadow:
      0 0 8px
      rgba(192,192,192,.45),

      0 0 14px
      rgba(139,0,0,.35);

  }

  25% {

    border-color:
      #777777;

    box-shadow:
      0 0 10px
      rgba(139,0,0,.65);

  }

  50% {

    border-color:
      #eeeeee;

    box-shadow:
      0 0 15px
      rgba(192,192,192,.6),

      0 0 20px
      rgba(139,0,0,.35);

  }

  75% {

    border-color:
      #8b0000;

    box-shadow:
      0 0 12px
      rgba(139,0,0,.7);

  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 480px) {

  .ko-snow {

    transform:
      scale(.7);

  }

  .marquee-track .marquee-text {

    font-size:
      12px;

  }

}

</style>



