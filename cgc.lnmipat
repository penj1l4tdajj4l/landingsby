<script>
/* -------------------------
  Config & helpers
------------------------- */
const rawInitials = ["A.R","D.K","S.M","R.F","L.H","Y.P","F.T","B.J","K.N","T.W"];
const jackpotNameEl = document.getElementById('jackpotName');
const jackpotAmountEl = document.getElementById('jackpotAmount');
const jackpotTimeEl = document.getElementById('jackpotTime');
const jackpotMain = document.getElementById('jackpotMain');
const historyList = document.getElementById('historyList');
const bgEl = document.getElementById('reviewsBg');

/* palette warna background jackpot (gradients) */
const bgPalettes = [
  'linear-gradient(135deg,#fff59d,#ffd54f)',
  'linear-gradient(135deg,#ffecb3,#ffb74d)',
  'linear-gradient(135deg,#ffea00,#ff9800)',
  'linear-gradient(135deg,#fff176,#ffcc33)',
  'linear-gradient(135deg,#ffe082,#ffb347)',
  'linear-gradient(135deg,#fff3b0,#ffc107)'
];

/* mask initial to form like T*****K */
function maskInitials(src){
  const letters = src.replace(/\W/g,'');
  if(letters.length >= 2){
    return letters.charAt(0) + '*****' + letters.charAt(letters.length-1);
  }
  return src.charAt(0) + '*****' + src.charAt(0);
}

/* format waktu: Hari, dd-mm-yyyy ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ hh:mm */
function formatWaktu(d=new Date()){
  const hari = ["Minggu","Senin","Selasa","Rabu","Kamis","Jumat","Sabtu"][d.getDay()];
  const tanggal = d.toLocaleDateString('id-ID');
  const jam = d.toLocaleTimeString('id-ID', { hour: "2-digit", minute:"2-digit" });
  return `${hari}, ${tanggal} ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ ${jam}`;
}

/* format money */
function formatRupiah(v){
  return 'Rp ' + v.toLocaleString('id-ID');
}

/* generate random jackpot amount */
function randomAmount(){
  return Math.floor(Math.random() * (50000000 - 5000000 + 1)) + 5000000;
}

/* fade update helper: add fade class and remove after animation */
function flashEl(el){
  el.classList.remove('fade');
  // force reflow
  void el.offsetWidth;
  el.classList.add('fade');
  setTimeout(()=> el.classList.remove('fade'), 900);
}

/* change jackpot background randomly with smooth transition */
function randomizeJackpotBg(){
  const bg = bgPalettes[Math.floor(Math.random() * bgPalettes.length)];
  jackpotMain.style.background = bg;
  // subtle transform
  jackpotMain.style.transform = 'translateY(-2px)';
  setTimeout(()=> jackpotMain.style.transform = 'translateY(0)', 350);
}

/* maintain history array (max entries) */
const history = [];
const MAX_HISTORY = 10;

/* push a new entry into history and render list */
function pushHistory(name, amount, timeStr){
  // newest first
  history.unshift({name, amount, time: timeStr});
  if(history.length > MAX_HISTORY) history.pop();

  // rebuild DOM (we'll duplicate list to allow seamless scroll)
  historyList.innerHTML = '';

  // create elements twice to allow continuous loop effect
  const build = (items) => {
    const frag = document.createDocumentFragment();
    items.forEach(it => {
      const div = document.createElement('div');
      div.className = 'history-item';
      div.innerHTML = `<span>${it.name} ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â <strong style="color:#b35a00">${it.amount}</strong></span><span style="font-size:.85rem;color:#7a4a00">${it.time}</span>`;
      frag.appendChild(div);
    });
    return frag;
  };

  // append current history then again to allow loop
  historyList.appendChild(build(history));
  historyList.appendChild(build(history));
  // set animation duration based on number of items (higher = slower)
  const itemHeight = 48; // approximate height including gap
  const totalHeight = history.length * itemHeight;
  const duration = Math.max(8, history.length * 1.8); // seconds
  historyList.style.animationDuration = duration + 's';
  historyList.style.animationTimingFunction = 'linear';
  historyList.style.animationName = 'scrollHistory';
  // define keyframes on the fly to scroll exactly totalHeight px
  const keyName = 'scrollHistory';
  // ensure style tag exists
  let ks = document.getElementById('kframesScroll');
  if(!ks){
    ks = document.createElement('style'); ks.id = 'kframesScroll'; document.head.appendChild(ks);
  }
  // animate from 0 to -totalHeight px
  ks.textContent = `
    @keyframes scrollHistory {
      0%{ transform: translateY(0); }
      100%{ transform: translateY(-${totalHeight}px); }
    }
  `;
}

/* announce for screen readers */
function announce(text){
  jackpotMain.setAttribute('aria-label', text);
}

/* initial update + periodic updates */
function randomJackpot(){
  // pick random source initial and mask it
  const raw = rawInitials[Math.floor(Math.random()*rawInitials.length)];
  const masked = maskInitials(raw);

  const amt = randomAmount();
  const formatted = formatRupiah(amt);
  const timeStr = formatWaktu(new Date());

  // update UI with fade
  jackpotNameEl.textContent = masked;
  jackpotAmountEl.textContent = formatted;
  jackpotTimeEl.textContent = timeStr;

  flashEl(jackpotNameEl);
  flashEl(jackpotAmountEl);
  flashEl(jackpotTimeEl);

  // change jackpot background color randomly
  randomizeJackpotBg();

  // also change reviews background color (subtle) to one of yellow shades
  const yellowShades = ['#fff59d','#ffecb3','#ffea00','#ffd54f','#fff176','#ffe082'];
  bgEl.style.background = yellowShades[Math.floor(Math.random()*yellowShades.length)];

  // push to history & start scroll
  pushHistory(masked, formatted, timeStr);

  // announce for a11y
  announce(`${masked} memenangkan ${formatted} pada ${timeStr}`);
}

/* initial call */
randomJackpot();

/* Update setiap 1 JAM (3600000ms) */
setInterval(randomJackpot, 3600000);

/* Optionally: also update small pulse color every 10s for liveliness */
setInterval(()=> {
  jackpotMain.style.boxShadow = '0 16px 40px rgba(0,0,0,0.18)';
  setTimeout(()=> jackpotMain.style.boxShadow = '0 12px 30px rgba(0,0,0,0.15)', 600);
}, 10000);

/* initial empty history seeds */
for(let i=0;i<3;i++){
  // seed few historical entries immediately (slightly offset times)
  const raw = rawInitials[Math.floor(Math.random()*rawInitials.length)];
  const masked = maskInitials(raw);
  const amt = randomAmount();
  const timeStr = formatWaktu(new Date(Date.now() - (i+1)*3600000)); // offset by hours now
  history.push({name: masked, amount: formatRupiah(amt), time: timeStr});
}
// render initial history
pushHistory(history[0].name, history[0].amount, history[0].time);
</script>

