  left: 27%;
  width: 8px;
  height: 8px;
  animation-duration: 10s;
  animation-delay: 1s;
}

.s5 {
  left: 36%;
  width: 4px;
  height: 4px;
  animation-duration: 7.5s;
  animation-delay: 3s;
}

.s6 {
